{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vatioboard-radio-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "radio-media.vatioboard.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://vatioboard.com,https://www.vatioboard.com",
    "SELF_HOSTNAME": "radio-media.vatioboard.com"
  },
  "ratelimits": [
    {
      "name": "STREAM_STARTS",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
