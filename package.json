{
  "name": "vatioboard",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "author": "VatioLibre Inc.",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare:ansv": "node scripts/build-ansv-cameras.mjs",
    "prepare:geo": "node scripts/build-worldwide-cameras.mjs",
    "fetch:cameras": "node scripts/fetch-worldwide-cameras.mjs",
    "analyze:cameras:maxspeed": "node scripts/analyze-camera-maxspeed-coverage.mjs",
    "create:app": "node scripts/create-app.mjs",
    "predev": "pnpm run prepare:geo",
    "dev": "vite",
    "prebuild": "pnpm run prepare:geo",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "test": "vitest run test/unit test/frontend-architecture && pnpm run test:smoke",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:smoke": "vitest run test/smoke --exclude test/smoke/spa-gps-background.test.js && vitest run test/smoke/spa-gps-background.test.js",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "less": "^4.5.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@jaames/iro": "^5.5.2",
    "@stanko/dual-range-input": "^1.0.1",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "chart.js": "^4.5.1",
    "geokdbush": "^2.0.1",
    "kdbush": "^4.0.2",
    "maplibre-gl": "^5.20.1",
    "mathjs": "^15.1.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4"
  },
  "engines": {
    "node": ">=24"
  }
}
